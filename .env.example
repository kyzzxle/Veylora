# Copy this file to .env and fill in values when you are ready.
# Every value is optional: anything left blank is simply switched off.

# Your live site address. Enables canonical URLs, the sitemap and robots.txt sitemap line.
SITE_URL=

# Public email address shown on the contact page.
PUBLIC_CONTACT_EMAIL=

# Contact form endpoint from a form service (e.g. https://formspree.io/f/xxxxxxx).
# Without it the form validates but tells visitors it is not connected yet.
PUBLIC_CONTACT_ENDPOINT=

# Google AdSense. Leave blank until your account is approved.
# Setting PUBLIC_ADSENSE_CLIENT also switches on the advertising section of the privacy policy.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_MID=
