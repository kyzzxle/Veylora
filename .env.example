# Optional local overrides. The live values are set in src/data/site.ts and
# astro.config.mjs, so the deployed site does not need a .env file.

# Your live site address. Enables canonical URLs, the sitemap and robots.txt sitemap line.
SITE_URL=

# Contact form endpoint (defaults to the site's Formspree form).
PUBLIC_CONTACT_ENDPOINT=

# Google AdSense (normally set in src/data/site.ts instead).
# Setting PUBLIC_ADSENSE_CLIENT also publishes ads.txt and the advertising section of the privacy policy.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_MID=
