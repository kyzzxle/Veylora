  flask: '<path d="M9 3h6M10 3v6.2L4.6 18.3A1.8 1.8 0 0 0 6.1 21h11.8a1.8 1.8 0 0 0 1.5-2.7L14 9.2V3"/><path d="M7 15h10"/><circle cx="10" cy="17.6" r=".6" fill="currentColor"/><circle cx="13.5" cy="18.2" r=".6" fill="currentColor"/>',
  heart: '<path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z"/><path d="M3 12h4l1.5-3 3 6 1.5-3h8"/>',
