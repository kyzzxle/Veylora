---
/**
 * Inline SVG icon set. Branch icons and UI icons share one component so they
 * stay visually consistent (24px grid, 1.75 stroke).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;

const paths: Record<string, string> = {
  // Branches
