  leaf: '<path d="M5 19c0-9 5.5-14 15-14 0 9.5-5 15-14 15"/><path d="M5 19 13 11M9 15h4M11 13V9"/>',
  pendulum: '<path d="M4 3h16M12 3l5 12"/><circle cx="17.6" cy="16.6" r="2.6"/><path d="M12 3 7 15" stroke-dasharray="1.5 2" opacity=".55"/><circle cx="6.4" cy="16.6" r="2.6" stroke-dasharray="1.5 2" opacity=".55"/>',
