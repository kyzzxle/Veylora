---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="logo-mark">
  <defs>
    <linearGradient id="vl-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--accent)"></stop>
      <stop offset="1" stop-color="var(--accent-2)"></stop>
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="38" height="38" rx="11" fill="url(#vl-grad)" opacity="0.14"></rect>
  <rect x="1" y="1" width="38" height="38" rx="11" fill="none" stroke="url(#vl-grad)" stroke-width="1.5"></rect>
  <ellipse cx="20" cy="20" rx="14" ry="5.5" fill="none" stroke="url(#vl-grad)" stroke-width="1.4" opacity="0.7" transform="rotate(-28 20 20)"></ellipse>
  <path d="M12 12.5 20 28l8-15.5" fill="none" stroke="url(#vl-grad)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="31.6" cy="14" r="2.2" fill="var(--accent)" class="logo-electron"></circle>
</svg>

<style>
  .logo-mark {
    flex: none;
  }
  .logo-electron {
    transform-origin: 20px 20px;
  }
  :global(a:hover) .logo-electron {
    animation: orbit 1.6s var(--ease) 1;
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
</style>
