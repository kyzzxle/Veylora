const toc = [
  { id: 'overview', label: 'The urinary system' },
  { id: 'kidney', label: 'Inside the kidney' },
  { id: 'nephron', label: 'The nephron, step by step' },
  { id: 'water', label: 'Water balance and ADH' },
  { id: 'regulation', label: 'Salt, acid and blood pressure' },
  { id: 'relevance', label: 'Kidneys and health' },
  { id: 'terms', label: 'Key terms' },
  { id: 'misconceptions', label: 'Common misconceptions' },
