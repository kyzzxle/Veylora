const references = [
  { text: 'Betts, J. G., et al. (2022). Anatomy and Physiology 2e, Chapter 25: The Urinary System. OpenStax.', url: 'https://openstax.org/books/anatomy-and-physiology-2e/pages/25-introduction' },
  { text: 'Hall, J. E., & Hall, M. E. (2020). Guyton and Hall Textbook of Medical Physiology (14th ed.), Chapters 26–30. Elsevier.' },
  { text: 'Koeppen, B. M., & Stanton, B. A. (2019). Renal Physiology (6th ed.). Elsevier.' },
  { text: 'National Institute of Diabetes and Digestive and Kidney Diseases. Your Kidneys & How They Work.', url: 'https://www.niddk.nih.gov/health-information/kidney-disease/kidneys-how-they-work' },
