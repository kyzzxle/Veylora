const toc = [
  { id: 'what', label: 'What is a black hole?' },
  { id: 'kinds', label: 'Kinds of black holes' },
  { id: 'lensing', label: 'How gravity bends light' },
  { id: 'ring', label: 'Einstein rings and arcs' },
  { id: 'formulas', label: 'The equations' },
  { id: 'micro', label: 'Microlensing' },
  { id: 'seeing', label: 'How we observe black holes' },
  { id: 'terms', label: 'Key terms' },
  { id: 'misconceptions', label: 'Common misconceptions' },
  { id: 'takeaways', label: 'Key takeaways' },
];

const references = [
  { text: 'Fraknoi, A., Morrison, D., & Wolff, S. C. (2022). Astronomy 2e, Chapter 24: Black Holes and Curved Spacetime. OpenStax.', url: 'https://openstax.org/books/astronomy-2e/pages/24-introduction' },
  { text: 'Event Horizon Telescope Collaboration (2019). First M87 Event Horizon Telescope Results. I. The Shadow of the Supermassive Black Hole. The Astrophysical Journal Letters, 875, L1.', url: 'https://doi.org/10.3847/2041-8213/ab0ec7' },
  { text: 'Paczyński, B. (1986). Gravitational microlensing by the galactic halo. The Astrophysical Journal, 304, 1–5.' },
