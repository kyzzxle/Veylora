  { id: 'equation', label: 'The overall equation' },
  { id: 'leaf', label: 'Inside a leaf' },
  { id: 'chloroplast', label: 'Inside a chloroplast' },
  { id: 'light-reactions', label: 'Stage 1: the light-dependent reactions' },
  { id: 'calvin', label: 'Stage 2: the Calvin cycle' },
