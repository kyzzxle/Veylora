---
import SimShell from '../../components/sim/SimShell.astro';
import SliderControl from '../../components/sim/SliderControl.astro';
import ChoiceControl from '../../components/sim/ChoiceControl.astro';
import PresetButtons from '../../components/sim/PresetButtons.astro';
import ToggleControl from '../../components/sim/ToggleControl.astro';
import Readout from '../../components/sim/Readout.astro';
import SimKey from '../../components/sim/SimKey.astro';
import GraphPanel from '../../components/sim/GraphPanel.astro';
---

<SimShell
  id="osmosis-sim"
  label="Osmosis simulation: a cell in a solution. Use the controls to change concentrations."
  showTime
  badge="Isotonic · Normal"
>
  <ChoiceControl
    name="osmo-cell"
    label="Cell type"
    value="animal"
    options={[
      { value: 'animal', label: 'Animal (red blood cell)' },
      { value: 'plant', label: 'Plant cell' },
    ]}
  />

  <SliderControl
    name="osmo-out"
    label="Outside solution"
    min={0}
    max={1200}
    step={10}
    value={300}
    scale={['0 (pure water)', '1200']}
    help="Solute concentration of the water around the cell. Changes apply instantly, like moving the cell into a new solution."
  >
    <PresetButtons
      for="osmo-out"
      label="Solution presets"
      presets={[
        { label: 'Distilled water', value: 0 },
        { label: 'Half-strength saline', value: 150 },
        { label: 'Isotonic (≈0.9% saline)', value: 300 },
        { label: 'Seawater', value: 1000 },
      ]}
    />
  </SliderControl>

  <SliderControl
    name="osmo-in"
    label="Inside the cell (starting)"
    min={150}
    max={600}
    step={10}
    value={300}
    help="How much solute the cell contains. Changing this starts a fresh cell at its original size."
  />

  <SliderControl
    name="osmo-perm"
    label="Membrane water permeability"
    min={0.25}
    max={3}
    step={0.25}
    value={1}
    help="Like adding or removing aquaporin channels. Watch whether it changes the speed, the final size, or both."
  />

  <ToggleControl name="osmo-labels" label="Show labels and flow arrows" checked />

  <SimKey
    items={[
      { label: 'Water molecule (can cross the membrane)', color: 'sim-water' },
      { label: 'Solute particle (cannot cross)', color: 'sim-solute' },
      { label: 'Cell membrane', color: 'sim-membrane', shape: 'ring' },
      { label: 'Cell wall', color: 'sim-wall', shape: 'square', class: 'plant-only', hidden: true },
    ]}
  />

  <Fragment slot="readouts">
    <Readout name="state" label="Cell state" value="Normal" key />
    <Readout name="tonicity" label="Solution is" value="Isotonic" />
    <Readout name="flow" label="Net water flow" value="None" />
    <Readout name="cross" label="Water crossings / s" value="0 in · 0 out" />
    <Readout name="vol" label="Cell volume" value="100%" />
    <Readout name="cin" label="Inside now" value="300 mOsm/L" />
    <Readout name="cout" label="Outside" value="300 mOsm/L" />
    <Readout name="turgor" label="Turgor pressure" value="0 kPa" class="plant-only" hidden />
    <Readout name="psi" label="Ψ inside / outside" class="plant-only" hidden />
  </Fragment>

  <GraphPanel
    slot="below"
    id="osmo-graph"
    title="Cell volume over time"
    desc="Graph of cell volume as a percentage of its original size, plotted against model time."
    compare
  />
</SimShell>

<script>
  import { mountSim } from '../shared/controller';
  import { initOsmosis } from './osmosis';
  mountSim('#osmosis-sim', initOsmosis);
</script>
